<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CommsManager.Maui.ViewModels"
             x:Class="CommsManager.Maui.Views.ArtistDetailPage"
             Title="Художник"
             x:DataType="viewmodels:ArtistDetailViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Данные художника" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="10">
                <Label Text="Имя" FontSize="14" />
                <Entry Text="{Binding Artist.Name}" Placeholder="Введите имя художника" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="Описание" FontSize="14" />
                <Editor Text="{Binding Artist.Description}" AutoSize="TextChanges" Placeholder="Описание художника..." HeightRequest="100" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="Дата создания" FontSize="14" />
                <Label Text="{Binding Artist.CreatedDate, StringFormat='{0:dd.MM.yyyy}'}" FontAttributes="Italic" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Сохранить" Command="{Binding SaveCommand}" BackgroundColor="#2b0b98" TextColor="White" />
                <Button Text="Отмена" Command="{Binding CancelCommand}" BackgroundColor="LightGray" TextColor="Black" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
