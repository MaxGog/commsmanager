<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:system="clr-namespace:System;assembly=netstandard"
             xmlns:viewmodels="clr-namespace:CommsManager.Maui.ViewModels"
             x:Class="CommsManager.Maui.Views.OrderDetailPage"
             Title="Заказ"
             x:DataType="viewmodels:OrderDetailViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Детали заказа" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="10">
                <Label Text="Название" FontSize="14" />
                <Entry Text="{Binding Order.Title}" Placeholder="Введите название заказа" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="Описание" FontSize="14" />
                <Editor Text="{Binding Order.Description}" AutoSize="TextChanges" Placeholder="Описание заказа..." HeightRequest="100" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Клиент" FontSize="14" />
                    <Picker ItemsSource="{Binding Customers}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                            Title="Выберите клиента" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Художник" FontSize="14" />
                    <Picker ItemsSource="{Binding Artists}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedArtist, Mode=TwoWay}"
                            Title="Выберите художника" />
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Сумма" FontSize="14" />
                    <Entry Text="{Binding Order.PriceAmount}" Keyboard="Numeric" Placeholder="0" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Валюта" FontSize="14" />
                    <Entry Text="{Binding Order.PriceCurrency}" Placeholder="RUB" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="10">
                <Label Text="Дедлайн" FontSize="14" />
                <DatePicker Date="{Binding Order.Deadline}" MinimumDate="{x:Static system:DateTime.Today}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="Статус" FontSize="14" />
                <Picker ItemsSource="{Binding StatusOptions}"
                        SelectedItem="{Binding Order.Status, Mode=TwoWay}"
                        Title="Выберите статус" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Сохранить" Command="{Binding SaveCommand}" BackgroundColor="#2b0b98" TextColor="White" />
                <Button Text="Отмена" Command="{Binding CancelCommand}" BackgroundColor="LightGray" TextColor="Black" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
